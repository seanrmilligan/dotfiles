{
  "allowNonWorkspaceAccess": false,
  "colorScheme": "dark",
  "model": "Claude Opus 5.5 (Medium)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(dotnet)",
      "command(ls)",
      "command(head)",
      "command(diff)",
      "command(md5sum)",
      "command(sleep)",
      "command(grep)",
      "command(find)",
      "command(apt list)",
      "command(which)",
      "command(tail)",
      "command(ps)",
      "command(pgrep)",
      "command(git log)",
      "command(git diff)",
      "command(git merge-base)",
      "command(git status)",
      "command(git check-ignore)",
      "command(git read-tree)",
      "command(git hash-object)",
      "command(git rev-parse)",
      "command(basename)",
      "command(cat)",
      "command(wc)",
      "command(jq)",
      "command(shellcheck)",
      "command(sort)",
      "command(echo)",
      "command(git ls-files)",
      "command(git show)",
      "command(git ls-tree)",
      "command(git grep)",
      "command(git reflog show)",
      "command(git range-diff)",
      "command(zgrep)",
      "command(stat)",
      "command(gh pr view)",
      "command(gh pr list)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh"
  },
  "trustedWorkspaces": [],
  "useG1Credits": true
}
