[user]
  email = hello@sean.codes
  name = Sean Milligan
[core]
  autocrlf = input
  editor = nano
  eol = native
  excludesfile = ~/.gitignore_global
  longpaths = true
  # Override global $LESS settings from .bashrc
  # -F: Automatically quit when the content is less than the screen height.
  # -+N: Override: turn off line numbers as they don't make sense in diff views.
  # -Q: Do not ring the bell upon scrolling to the beginning or end of the file.
  # -R: Print ANSI control characters to enable shell syntax highlighting.
  # -S: Prefer horizontal scrolling over line wrapping.
  pager = less -F -Q -R -S -+N
[init]
  defaultBranch = "master"
[pull]
  rebase = false
[diff]
  # Always show file moves as moves, not delete/add
  renameLimit = 10000
[alias]
  undo = reset HEAD~
  # View the last commit in git log, only
  last = log -1 HEAD
  # Swap the last two commits in the commit history (for easier amending)
  swap = "!GIT_SEQUENCE_EDITOR=\"sed -i -n 'h;1n;2p;g;p'\" git rebase -i HEAD~2"
  ignored = ls-files --others --ignored --exclude-standard

